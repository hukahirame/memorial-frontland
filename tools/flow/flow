#!/bin/sh
# 宣言した種別と、実際にステージされた差分の形が合っているかを見る。
# commit-msg フックから呼ばれる。判定だけを行い、ファイルは直さない。
#
#   flow verify --message <コミットメッセージのファイル>
#
# 見ているのは差分の形と宣言が合っているかだけで、中身は見ない。
# 出力は回復手順として読めるようにする。1行1件、何を直すかまで書く。

command="$1"
shift 2>/dev/null

message=""
while [ $# -gt 0 ]; do
  case "$1" in
    --message)
      message="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$command" != "verify" ]; then
  echo "E  使える命令は verify だけ"
  exit 1
fi

if [ -z "$message" ] || [ ! -f "$message" ]; then
  echo "E  --message にコミットメッセージのファイルが要る"
  exit 1
fi

type=$(sed -n 's/^Change-Type: \(.*\)$/\1/p' "$message" | tail -1)
staged=$(git diff --cached --name-only)

# 中身の無いコミットは見ない
if [ -z "$staged" ]; then
  exit 0
fi

failed=0

# REFACTOR-DIRTY
#
# refactor では仕様書が変わってはいけない。これが守られるから、refactor の
# レビューは「仕様書の差分が空である」ことの確認で済む。
if [ "$type" = "refactor" ]; then
  specs=$(printf '%s\n' "$staged" | grep '^docs/systems/.*\.md$')

  if [ -n "$specs" ] && ! grep -q '^Spec-Changed: .' "$message"; then
    echo "E  REFACTOR-DIRTY  refactor で仕様書が変わっている"
    printf '%s\n' "$specs" | sed 's/^/     /'
    echo "     振る舞いが変わったなら feat か fix。変わっていないなら仕様書を戻す"
    echo "     意図して変えたなら Spec-Changed: <理由> を足す"
    failed=1
  fi
fi

# API-CHANGED
#
# refactor で公開している面が変わったら、人間の承認が要る（refactor.md）。
# 承認の対象は docs/public-api.txt の差分だけで、実装は見ない。
if [ "$type" = "refactor" ]; then
  api=$(printf '%s\n' "$staged" | grep '^docs/public-api\.txt$')

  if [ -n "$api" ] && ! grep -q '^Api-Changed: .' "$message"; then
    echo "E  API-CHANGED  refactor で公開APIが変わっている"
    echo "     git diff --cached docs/public-api.txt で増減を見る"
    echo "     人間に提示して承認を取り、Api-Changed: <理由> を足す"
    failed=1
  fi
fi

# FIX-TEST-WEAKENED
#
# fix で既存のテストを書き換えていないか。落ちるテストを緩めて直したことにする
# のが一番静かな壊し方なので、書き換えたこと自体を表に出す。
# テストを足すのは自由。見るのは既にあるファイルへの変更だけ。
if [ "$type" = "fix" ]; then
  touched=$(git diff --cached --name-only --diff-filter=M \
            -- 'tests/*' 'Assets/_Project/Tests/*')

  if [ -n "$touched" ] && ! grep -q '^Test-Change: .' "$message"; then
    echo "E  FIX-TEST-WEAKENED  fix で既存のテストが変わっている"
    printf '%s\n' "$touched" | sed 's/^/     /'
    echo "     既存テストが落ちるなら、それは仕様が変わったということ（fix.md）"
    echo "     やむを得ないなら Test-Change: <理由> を足す"
    failed=1
  fi
fi

# DOCS-CODE
#
# docs で触れるのは文書だけ。コードが混ざるなら種別が違う。
if [ "$type" = "docs" ]; then
  others=$(printf '%s\n' "$staged" | grep -v -e '\.md$' -e '^docs/')

  if [ -n "$others" ]; then
    echo "E  DOCS-CODE  docs で文書以外が変わっている"
    printf '%s\n' "$others" | sed 's/^/     /'
    echo "     種別を変えるか、コミットを割る。解除トレーラーは無い"
    failed=1
  fi
fi

# TEST-CODE
#
# test で触れるのはテストだけ。実装が混ざると、テストが通ったことの意味が消える。
if [ "$type" = "test" ]; then
  outside=$(printf '%s\n' "$staged" | grep -v -e '^tests/' -e '^Assets/_Project/Tests/')

  # テストが作る生成物は数えない。実装をそこに隠せないので、見張る意味が無い。
  # 見分けは先頭の「手で編集しない」。生成物には必ず書いてある
  others=""
  for path in $outside; do
    if [ -f "$path" ] && head -5 "$path" | grep -q "手で編集しない"; then
      continue
    fi
    others="$others$path
"
  done
  others=$(printf '%s' "$others")

  if [ -n "$others" ]; then
    echo "E  TEST-CODE  test でテスト以外が変わっている"
    printf '%s\n' "$others" | sed 's/^/     /'
    echo "     種別を変えるか、コミットを割る。解除トレーラーは無い"
    failed=1
  fi
fi

# TUNE-CODE
#
# tune は値だけ。コードが変わるなら、値を外に出す作業が先（tune.md）。
if [ "$type" = "tune" ]; then
  sources=$(printf '%s\n' "$staged" | grep '\.cs$')

  if [ -n "$sources" ]; then
    echo "E  TUNE-CODE  tune でコードが変わっている"
    printf '%s\n' "$sources" | sed 's/^/     /'
    echo "     値を外に出す作業は feat か refactor。解除トレーラーは無い"
    failed=1
  fi
fi

exit $failed
