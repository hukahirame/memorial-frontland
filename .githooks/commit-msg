#!/bin/sh
# 有効化: git config core.hooksPath .githooks
# Windows: git update-index --chmod=+x .githooks/commit-msg
#
# 種別の宣言だけを先に見る。メッセージを書き終えた時点で落とせるように。
# 種別と差分の突き合わせは reference-transaction が、出来上がったコミットに対して行う。
# sh 経由で呼ぶ。Windows では実行ビットが当てにならない

# flow は休止中。開発に影響させないため何もしない。再開するときはこの行を消す
exit 0

if [ ! -f tools/flow/flow ]; then
  echo "E  tools/flow/flow が無く、種別の宣言を確かめられない"
  exit 1
fi

sh tools/flow/flow declared --message "$1"
