<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity を起動せずに Domain 層を検証するためのプロジェクト。
    Assets/ の外に置くことで Unity からは無視される。
    ソースは写しを作らず、Unity 側と同一のファイルを直接コンパイルする。
    MemorialFloor.Domain は noEngineReferences のため UnityEngine 無しで通る。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>MemorialFloor.Domain.DotnetTests</AssemblyName>

    <!--
      Domain 層に .NET アナライザを適用する。Unity のコンパイルは .NET SDK を
      通らないためこの規則が効かないが、ここでビルドすれば CI で検出できる。
      CA1051: 書き換え可能な public インスタンスフィールドを宣言しない。
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- IDE 系（命名規則）はこれが無いとビルド時に走らない -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Domain/**/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/Domain/**/*.cs" />
    <!-- dotnet 専用。Unity 側に置くと UnityEngine 非依存の前提が崩れる -->
    <Compile Include="DomainDiagramTests.cs" />
    <Compile Include="DependencyGraphGenerator.cs" />
    <Compile Include="DependencyGraphTests.cs" />
    <Compile Include="SliceDiagramGenerator.cs" />
    <Compile Include="SliceDiagramTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>