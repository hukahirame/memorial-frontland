{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(unity command set_authoring_root *)",
      "PowerShell(unity command set_authoring_root *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "PowerShell(git commit -n *)",
      "Bash(git -c *)",
      "PowerShell(git -c *)"
    ],
    "ask": [
      "Bash(unity command delete_asset *)",
      "PowerShell(unity command delete_asset *)",
      "Bash(unity command move_asset *)",
      "PowerShell(unity command move_asset *)",
      "Bash(unity command rename_asset *)",
      "PowerShell(unity command rename_asset *)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Edit(ProjectSettings/**)",
      "Write(ProjectSettings/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/log-unity-checkpoint.ps1"
            ],
            "if": "PowerShell(unity command *)",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/log-unity-checkpoint.ps1"
            ],
            "if": "Bash(unity command *)",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
